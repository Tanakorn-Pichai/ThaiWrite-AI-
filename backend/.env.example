# PostgreSQL Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/thaiwrite_db

# Redis (Celery broker & result backend)
REDIS_URL=redis://localhost:6379/0

# S3-Compatible Storage (AWS S3 or MinIO)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
STORAGE_BUCKET_NAME=thaiwrite-docs
S3_REGION=ap-southeast-1

# Optional Gemini deep academic grammar review (backend only)
GEMINI_API_KEY=YOUR_ROTATED_GEMINI_KEY
GEMINI_MODEL=gemini-2.5-flash
ENABLE_GEMINI_GRAMMAR=false

# Application Settings
PORT=8000
MAX_UPLOAD_SIZE_MB=10
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173
